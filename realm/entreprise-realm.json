{
  "realm": "Sista",
  "displayName": "Sista consult",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(10) and digits(1) and upperCase(1) and notUsername",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en", "ar"],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      { "name": "employe", "description": "Tout employé de l'entreprise" },
      { "name": "admin", "description": "Administrateurs du bureau" }
    ],
    "client": {
      "app-api": [
        { "name": "user", "description": "Utilisateur standard de l'application" },
        { "name": "admin", "description": "Administrateur fonctionnel de l'application" }
      ]
    }
  },

  "groups": [
    {
      "name": "employes",
      "realmRoles": ["employe"],
      "clientRoles": { "app-api": ["user"] }
    }
  ],

  "clients": [
    {
      "clientId": "app-api",
      "name": "API backend",
      "description": "Serveur de ressources : porte les rôles, ne fait aucun login",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "app-web",
      "name": "Front web Angular",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "audience-app-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "app-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "app-mobile",
      "name": "Application mobile Flutter",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["auth.sistaconsult.com:/oauthredirect"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "auth.sistaconsult.com:/logout"
      },
      "protocolMappers": [
        {
          "name": "audience-app-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "app-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "mohamed",
      "email": "mohamed@sistaconsult.mr",
      "firstName": "Mohamed",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/employes"],
      "clientRoles": { "app-api": ["admin"] },
      "credentials": [{ "type": "password", "value": "mohamed", "temporary": false }]
    },
    {
      "username": "alassane",
      "email": "elhasseneba@sistaconsult.mr",
      "firstName": "Elhassene",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/employes"],
      "credentials": [{ "type": "password", "value": "alassane", "temporary": false }]
    }
  ]
}
